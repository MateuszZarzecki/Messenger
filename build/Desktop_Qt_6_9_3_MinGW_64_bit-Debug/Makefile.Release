QMAKE_TARGET  = messenger
DESTDIR        = release\ #avoid trailing-slash linebreak
TARGET         = messenger.exe
DESTDIR_TARGET = release\messenger.exe

####### Build rules

first: all
all: Makefile.Release  release/messenger.exe

release/messenger.exe:  $(OBJECTS) 
	$(LINKER) $(LFLAGS) -o $(DESTDIR_TARGET) @release\object_script.messenger.Release $(LIBS)

qmake: FORCE
	@$(QMAKE) -o Makefile.Release ..\..\MessengerQMake.pro -spec win32-g++ "CONFIG+=debug" "CONFIG+=qml_debug"

qmake_all: FORCE

dist:
